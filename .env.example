# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only, never sent to the browser).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (AI Studio injects this automatically).
APP_URL="MY_APP_URL"

# Optional — night alerts on your phone while the app is closed (see worker/README.md)
VITE_PUSH_WORKER_URL=
VITE_VAPID_PUBLIC_KEY=
